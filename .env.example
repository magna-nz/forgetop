# forgetop integration-test credentials — LOCAL ONLY, gitignored, never commit.
#
# Fill in the values, then run:
#   cargo test -p forgetop-providers --features integration -- --nocapture --test-threads=1
#
# Leave a provider's values BLANK to skip it — blank = skipped, a real value = the
# suite tries to authenticate. Start with GitHub only if you like.
# See INTEGRATION.md for the full setup guide.

# Set to 1 to sweep leftover forgetop-it-* fixtures before tests (useful after a
# crashed run). Leave blank in CI — it deletes ALL such fixtures, unsafe if runs
# overlap. Blank by default.
FORGETOP_IT_SWEEP=

# ── GitHub ──────────────────────────────────────────────────────────────────
# Classic PAT, scopes: repo, workflow (your user must have admin on the repo).
# REPO is the throwaway container repo "owner/name" (public = free Actions minutes).
FORGETOP_IT_GITHUB_TOKEN=
FORGETOP_IT_GITHUB_REPO=
# Optional — only for GitHub Enterprise Server; blank = github.com:
FORGETOP_IT_GITHUB_HOST=

# ── GitLab (Wave 3) ─────────────────────────────────────────────────────────
# PAT scope: api (you must be Maintainer/Owner). PROJECT is the numeric id.
FORGETOP_IT_GITLAB_TOKEN=
FORGETOP_IT_GITLAB_PROJECT=
# Optional — only for self-hosted GitLab; blank = gitlab.com:
FORGETOP_IT_GITLAB_HOST=

# ── Azure DevOps (Wave 4) ───────────────────────────────────────────────────
# PAT with Full access (throwaway). Use a PUBLIC project for free hosted agents.
FORGETOP_IT_AZURE_PAT=
FORGETOP_IT_AZURE_ORG=
FORGETOP_IT_AZURE_PROJECT=
FORGETOP_IT_AZURE_REPO=

# ── Bitbucket (pull requests + pipelines) ───────────────────────────────────
# App password (Personal settings → App passwords). Discovery lists the whole
# workspace, so it needs **Repositories: Read** — normally implied by
# "Pull requests: read". WORKSPACE is the {workspace} in bitbucket.org/{workspace};
# REPO is a repo slug inside it. Blank = skip Bitbucket.
FORGETOP_IT_BITBUCKET_USERNAME=
FORGETOP_IT_BITBUCKET_APP_PASSWORD=
FORGETOP_IT_BITBUCKET_WORKSPACE=
FORGETOP_IT_BITBUCKET_REPO=

# ── Linear (work items only) ────────────────────────────────────────────────
# Personal API key (Settings → Security & access → API → Personal API keys).
# TEAM is optional — the first team is used if blank.
FORGETOP_IT_LINEAR_KEY=
FORGETOP_IT_LINEAR_TEAM=

# ── Jira (work items only) ──────────────────────────────────────────────────
# API token (id.atlassian.com/manage-profile/security/api-tokens) + your email.
# SITE is https://your-site.atlassian.net; PROJECT is the project key (e.g. IT).
FORGETOP_IT_JIRA_TOKEN=
FORGETOP_IT_JIRA_EMAIL=
FORGETOP_IT_JIRA_SITE=
FORGETOP_IT_JIRA_PROJECT=
